{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "files": {
    "includes": [
      "**",
      "!**/node_modules",
      "!**/dist",
      "!**/.xtemplates",
      "!**/.autopilot",
      "!**/.claude",
      "!**/*.md"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 110
  },
  "linter": {
    "rules": {
      "preset": "recommended"
    }
  },
  "overrides": [
    {
      "includes": ["docs/autopilot/ACCEPTANCE.json", "docs/autopilot/STAGE.json", "docs/ops/DEPLOYS.json"],
      "formatter": {
        "enabled": false
      }
    }
  ]
}
